# Copiar a .env.pd (no commitear secretos)

NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://app.example.com

# Postgres. Las tablas viven en PG_SCHEMA (no en public).
PG_DSN=
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=postgres
PG_SCHEMA=taskia
PG_SSLMODE=require

JWT_SECRET=change-me-production-secret
JWT_EXPIRES_IN=12h
COOKIE_NAME=taskia_token
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
